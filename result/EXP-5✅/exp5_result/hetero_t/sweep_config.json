{
  "base": {
    "dataset": {
      "source": "synthetic",
      "name": "hetero_t",
      "dim": 2,
      "synthetic": {
        "generator": "hetero_sizes",
        "n_r": 100000,
        "n_s": 100000,
        "alpha": 1.0,
        "seed": 1,
        "params": {"anisotropic":true, "p_large":0.1, "w_small_min":0.002, "w_small_max":0.01, "w_large_min":0.1, "w_large_max":0.3, "shuffle_r":false, "shuffle_s":false}
      }
    },
    "run": {
      "method": "ours",
      "variant": "sampling",
      "t": 10000,
      "seed": 1,
      "repeats": 3,
      "j_star": 1000000,
      "enum_cap": 0,
      "write_samples": false,
      "verify": false,
      "extra": {
        "pbsm_scheme": "stripes",
        "pbsm_k": 0,
        "pbsm_part_axis": 0,
        "pbsm_sweep": "orthogonal",
        "tlsop_nx": 128,
        "tlsop_ny": 128,
        "tlsop_reuse_sort": true,
        "sirs_outer": "",
        "sirs_leaf_size": 32,
        "rej_index": "S",
        "rej_rep_center": false,
        "rej_count_draws": 50000,
        "rej_max_factor": 10000
      }
    },
    "output": { "out_dir": "run/temp/exp5/hetero_t", "run_tag": "exp5_hetero_t" },
    "logging": { "level": "info", "with_timestamp": true, "with_thread_id": false },
    "sys": { "threads": 1 }
  },

  "sweep": {
    "t": [1000, 3000, 10000, 30000, 100000, 300000, 1000000],
    "method": ["ours", "aabb", "interval_tree", "kd_tree", "r_tree", "range_tree", "pbsm", "tlsop", "sirs", "rejection"],
    "variant": ["sampling", "adaptive"]
  },

  "files": { "raw": "sweep_raw.csv", "summary": "sweep_summary.csv" },
  "meta": { "note": "EXP-5 (RQ5): distribution robustness; runtime vs t; dist=hetero" }
}
