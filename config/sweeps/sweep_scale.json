{
  "base": {
    "dataset": {
      "source": "synthetic",
      "name": "rectgen_scale",
      "dim": 4,
      "path_r": "",
      "path_s": "",
      "synthetic": {
        "generator": "alacarte_rectgen",
        "n_r": 100000,
        "n_s": 100000,
        "alpha": 10.0,
        "seed": 1,
        "params": {
          "audit_pairs": 2000000,
          "audit_seed": 0
        }
      }
    },

    "run": {
      "method": "ours",
      "variant": "sampling",
      "t": 100000,
      "seed": 1,
      "repeats": 3,

      "j_star": 1000000,
      "enum_cap": 0,
      "write_samples": false,
      "verify": false,

      "extra": {
        "csv_sep": "tab"
      }
    },

    "output": {
      "out_dir": "results/sweeps/scale",
      "run_tag": "scale_sweep"
    },

    "logging": {
      "level": "info",
      "with_timestamp": true,
      "with_thread_id": false
    },

    "sys": {
      "threads": 1
    }
  },

  "sweep": {
    "n": [
      100000,
      200000,
      400000,
      800000,
      1600000,
      3200000,
      5000000
    ],
    "t": [
      100000
    ],
    "method": [
      "ours",
      "range_tree",
      "kd_tree"
    ],
    "variant": [
      "sampling",
      "adaptive"
    ]
  },

  "files": {
    "raw": "sweep_raw.csv",
    "summary": "sweep_summary.csv"
  },

  "meta": {
    "note": "Scale sweep varies N with equal sides (N:=|R|=|S|). Fixed dim=4, alpha_out=10, t=1e5."
  }
}
